{
  "name": "insify",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/shared-types"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:fingerprint": "cd fingerprint && uvicorn main:app --reload",
    "install:all": "npm install && cd fingerprint && pip install -r requirements.txt"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}